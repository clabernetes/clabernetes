  "capabilities": [
    {
      "id": "kind-plan",
      "description": "A deterministic direct-runtime plan covers the kind's default realization; detailed behavior capabilities remain to be inventoried."
    },
    {
      "id": "process",
      "description": "Images, entrypoints, commands, users, environment, ports, and stop behavior are planned and realized."
    },
    {
      "id": "configuration",
      "description": "Startup configuration, variables, licenses, certificates, and vendor file transformations are preserved."
    },
    {
      "id": "filesystem",
      "description": "Payloads, binds, tmpfs, shared memory, and persistence have defined direct-Pod semantics."
    },
    {
      "id": "security",
      "description": "Devices, capabilities, privilege, security profiles, and sysctls are enforced or rejected."
    },
    {
      "id": "resource-policy",
      "description": "Application and component resources and scheduling policy are represented in Kubernetes."
    },
    {
      "id": "management",
      "description": "Management addressing, routes, DNS, and exposure are directly realized."
    },
    {
      "id": "components",
      "description": "Grouped Nodes and chassis expand into visible application containers with validated namespace ownership."
    },
    {
      "id": "readiness",
      "description": "Preparation, containers, components, connectivity, image health, and probes contribute to readiness."
    },
    {
      "id": "connectivity",
      "description": "Every Link flavor has ordered, live, restart-safe, and cleanup-safe direct realization."
    },
    {
      "id": "image-pull",
      "description": "The kubelet pulls device images with native policy and Secrets while c9s resolves metadata."
    },
    {
      "id": "lifecycle",
      "description": "Post-start, restart or recreate policy, save, and lifecycle actions target direct containers."
    },
    {
      "id": "operations",
      "description": "Logs, exec, events, save, and packet capture operate on direct containers and interfaces."
    },
    {
      "id": "entry-path",
      "description": "Direct resources, Topology, and clabverter produce equivalent labs."
    }
  ],
  "scenarios": [
    {
      "id": "plan-default",
      "description": "Generate and verify the default direct-runtime plan for the canonical kind and every alias."
    },
    {
      "id": "node-image-process",
      "description": "Preserve kind, type, image, entrypoint, command, user, environment, and image defaults."
    },
    {
      "id": "node-startup-configuration",
      "description": "Generate, enforce, suppress, mount, and validate startup configuration, variables, licenses, and certificates."
    },
    {
      "id": "node-post-start-exec",
      "description": "Run declared post-start commands against the direct device container and report failures."
    },
    {
      "id": "node-payloads-binds",
      "description": "Stage ConfigMap, Secret, URL, environment-file, bind, and vendor payloads with exact destination and mode semantics."
    },
    {
      "id": "node-security",
      "description": "Enforce or reject devices, capabilities, privilege, security options, and sysctls."
    },
    {
      "id": "node-memory-filesystems",
      "description": "Realize tmpfs and shared-memory sizing and cleanup."
    },
    {
      "id": "node-exposure",
      "description": "Allocate destination ports and route Services to the direct application container."
    },
    {
      "id": "node-management",
      "description": "Realize static IPv4 and IPv6 intent, DNS, routes, and certificates while preserving Kubernetes transport."
    },
    {
      "id": "node-grouping",
      "description": "Realize network-mode container groups as application containers in one Pod."
    },
    {
      "id": "node-imported-extras",
      "description": "Plan and apply generic extra operations emitted by imported containerlab hooks."
    },
    {
      "id": "node-components",
      "description": "Expand and observe component or distributed-chassis containers without a nested runtime."
    },
    {
      "id": "node-profile-policy",
      "description": "Apply reusable scheduling, resources, image pull, exposure, persistence, and probe policy."
    },
    {
      "id": "global-config-policy",
      "description": "Apply global metadata, DNS suffix, image pull, deployment defaults, and naming without nested-runtime settings."
    },
    {
      "id": "node-persistence",
      "description": "Preserve declared device state across direct Pod recreation."
    },
    {
      "id": "node-image-pull",
      "description": "Pull public and private images through Kubernetes and reject unsupported registry policy."
    },
    {
      "id": "node-bootstrap",
      "description": "Prepare and start devices without dockerd, containerlab, image import, or nested discovery."
    },
    {
      "id": "node-readiness",
      "description": "Report logical readiness from direct container, component, connectivity, and probe observations."
    },
    {
      "id": "link-same-pod",
      "description": "Create and remove same-Pod endpoint interfaces with exact name and MTU."
    },
    {
      "id": "link-vxlan",
      "description": "Carry traffic and recover direct VXLAN Links across workers."
    },
    {
      "id": "link-slurpeeth",
      "description": "Carry traffic and recover direct slurpeeth Links across workers."
    },
    {
      "id": "link-host",
      "description": "Create, reconcile, and clean up UID-owned host Links."
    },
    {
      "id": "link-loopback",
      "description": "Create, reconcile, and clean up loopback Links."
    },
    {
      "id": "link-live-reconcile",
      "description": "Apply add, rewire, delete, restart, recreate, reschedule, and recovery behavior idempotently."
    },
    {
      "id": "operation-logs",
      "description": "Read the actual device container logs through Kubernetes."
    },
    {
      "id": "operation-exec",
      "description": "Execute commands in the selected direct device or component container."
    },
    {
      "id": "operation-save",
      "description": "Save device configuration through the planned direct lifecycle action."
    },
    {
      "id": "operation-events",
      "description": "Report direct device and connectivity lifecycle events."
    },
    {
      "id": "operation-packet-capture",
      "description": "Capture packets on a resolved direct device interface."
    },
    {
      "id": "entry-direct-resources",
      "description": "Direct Node, Link, and LauncherProfile resources produce a running direct lab."
    },
    {
      "id": "entry-topology",
      "description": "Topology compilation preserves representable semantics and produces a running direct lab."
    },
    {
      "id": "entry-clabverter",
      "description": "Clabverter produces equivalent direct resources or rejects semantic loss."
    }
  ],
